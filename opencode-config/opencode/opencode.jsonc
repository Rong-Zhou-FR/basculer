{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "copilot",
  "plugin": ["opencode-notify",
    "./plugins/opencode-worktree-enhanced/index.ts",
    // "./plugins/opencode-metasearch2/index.ts",  // disabled: brave-search is always available (#5)
    "./plugins/mcp-daemon.ts"
  ],
  "mcp": {
    "paper-search": {
      "type": "local",
      "command": ["/home/rongzhou/.npm-global/bin/paper-search-mcp-nodejs"],
      "environment": {
        // "WOS_API_KEY": "your_actual_api_key_here",
        // "PUBMED_API_KEY": "your_ncbi_api_key_here",
        // "ELSEVIER_API_KEY": "your_elsevier_api_key",
        // "SPRINGER_API_KEY": "your_springer_api_key",
        // "WILEY_TDM_TOKEN": "your_wiley_tdm_token"
      },
      "enabled": false
    },
    "mcp_hugging_face": {
      "type": "remote",
      "enabled": false,
      "url": "https://huggingface.co/mcp?login",
      "oauth": {}
    },
    "brave-search": {
      // Shared HTTP daemon started by mcp-daemon plugin on port 8124.
      // No per-session instances — all sessions share one connection.
      "type": "remote",
      "url": "http://127.0.0.1:8124/mcp",
      "enabled": true
    },
    "gortex": {
      // Gortex: single-binary Go daemon for multi-repo code intelligence.
      // One daemon for all repos (~64 MiB) vs serena's ~600 MB per instance.
      // Tree-sitter based, 100+ MCP tools, session isolation, structured memories.
      // https://github.com/zzet/gortex
      "type": "local",
      "command": ["gortex", "mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "serena": {
      // DISABLED — replaced by gortex (above). Keep config for easy re-enable.
      "type": "local",
      "enabled": false,
      "command": ["serena", "start-mcp-server", "--project-from-cwd", "--open-web-dashboard", "false"],
      "timeout": 60000
    },
    "context7": {
      // Local proxy reads key from file (never in config).
      // See context7-mcp-proxy.mjs for implementation.
      "type": "local",
      "command": ["node", "/home/rongzhou/.config/opencode/context7-mcp-proxy.mjs"],
      "environment": {
        "CONTEXT7_API_KEY_FILE": "/home/rongzhou/.config/opencode/.secrets/context7-api-key"
      },
      "enabled": true,
      "timeout": 30000
    },
    "mcp_github": {
      // Disabled: GitHub Copilot MCP would need its PAT from file.
      // When re-enabling, use a local wrapper proxy (like context7 above)
      // or set env var GITHUB_TOKEN from the secret file.
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      }
    }
  },
  "provider": {
    "rr": {
      "models": {},
      "options": {
        "baseURL": "http://localhost:8000/v1"
      }
    }
  },

  "experimental": {
    // Global timeout for MCP requests (ms). Mitigates transient listTools()
    // failures in opencode serve+attach mode that permanently remove MCP
    // clients from state.clients with no retry (opencode#38266, #17099).
    "mcp_timeout": 30000
  },

  "permission": {
    // worktreeCreate spawns fresh opencode sessions — gitmaster only
    "worktreeCreate": "deny",
    "worktreeNew": "allow",
    "worktreeDelete": "allow",
    "worktreeList": "allow",
    "bash": {
      // Destructive commands — agent must ask for approval:
      "git reset --hard*": "ask",         // destroys all uncommitted local work
      "git push --force*": "ask",          // overwrites remote history
      "git push -f*": "ask",               // same, short form
      "git clean -f*": "ask",              // deletes untracked files/folders
      "git checkout -- *": "ask",          // discards working tree changes
      // Branch switching — ask (use "git worktree add" instead; multiple agents run concurrently)
      "git checkout ": "ask",             // switches branch — disrupts other agents
      "git checkout -b*": "ask",          // creates AND switches to new branch
      "git checkout -B*": "ask",          // force creates AND switches
      "git switch *": "ask",              // modern branch switching
      // Destructive stash operations — ask (modifies working tree shared by all agents)
      "git stash drop*": "ask",
      "git stash clear*": "ask",
      "git stash pop*": "ask",
      "git stash apply*": "ask",
      // Worktree operations (safe — isolated dirs, no branch-switching on main)
      "git worktree add*": "allow",        // creates isolated worktree — safe
      "git worktree remove*": "ask",       // removes worktree — could affect others
      "git worktree prune*": "ask",        // prunes worktrees — could affect others
      "git restore .": "ask",              // same, modern form
      "git rm -r*": "ask",                 // removes files from both disk and git
      "git rebase *": "ask",               // rewrites commit history
      "git filter-branch*": "ask",         // repo-wide history rewrite (nuclear)
      "git branch -D*": "ask",             // force-deletes branches
      "git stash drop*": "ask",            // permanently deletes a stash
      "git stash clear*": "ask",           // deletes all stashes
      "docker system prune -af*": "ask",   // nukes all containers, images, networks
      "docker system prune --all*": "ask", // same, long flag form
      "docker rm -f *": "ask",             // force-removes containers
      "docker rmi -f *": "ask",            // force-removes images
      "docker volume rm -f *": "ask",      // destroys all volumes with data
      "find . -delete*": "ask",            // bulk deletion via find
      "find . -exec rm*": "ask",           // same, alternative syntax
      "sudo *": "ask",                     // any sudo command (escalation)
      "chmod -R 0*": "ask",                // locks all files in a directory
      "chown -R*": "ask",                  // bulk ownership change
      "truncate -s 0*": "ask",             // truncates files to zero bytes
      "dd if=/dev/zero of=*": "ask",       // zeroes out files or disks
      "rm -rf*": "ask",                    // classic filesystem nuke
      "rm -fr*": "ask",                    // same, flag order swapped
      "pkill*": "ask",                     // kills processes by name/pattern — inherently imprecise
      "killall*": "ask",                   // same, different tool
      "kill -9*": "ask"                    // SIGKILL by PID — can't be caught, data-loss risk
    },
    "external_directory": {
      "*": "ask",
      // Read-only runtime introspection (/proc is a kernel interface, not a data dir)
      "/proc/meminfo": "allow",
      "/proc/cpuinfo": "allow",
      "/proc/loadavg": "allow",
      "/proc/uptime": "allow",
      "/proc/stat": "allow",
      "/proc/version": "allow",
      "/proc/**/status": "allow",
      "/proc/**/cmdline": "allow",
      "/tmp/**": "allow",
      "**/.ssh/**": "allow",
      "~/.local/share/opencode/**": "allow",
      "~/.opencode/**": "allow",
      "~/kodo/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.config/lighterbird/**": "allow",
      "**serena/**": "allow",
      "~/.local/share/lighterbird/**": "allow",
      "~/tmp": "allow",
      "~/tmp/**": "allow"
    },
    "edit": {
      "/proc/**": "deny",
      "*": "allow"
    }
  },

  "agent": {
    "copilot": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "auditor": {
      "model": "deepseek/deepseek-v4-flash"
    },
    // "explore": {
    //   "model": "opencode/deepseek-v4-flash-free"
    // },
    // "tester": {
    //   "model": "opencode/deepseek-v4-flash-free"
    // },
  //   "debugger": {
  //     "model": "opencode/deepseek-v4-flash-free"
  //   },
  //   "reviewer": {
  //     "model": "opencode/deepseek-v4-flash-free"
  //   },
  //   "refactorer": {
  //     "model": "opencode/deepseek-v4-flash-free"
  //   },
    "architect": {
      "model": "deepseek/deepseek-v4-flash"
    },
  //   "planner": {
  //     "model": "opencode/deepseek-v4-flash-free"
  //   },
    "expert": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "githubber": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "huggingfacer": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "gitmaster": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "build": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  }
}
