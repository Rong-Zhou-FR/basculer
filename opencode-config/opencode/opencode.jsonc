{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "copilot",
  "plugin": ["opencode-notify",
    "./plugins/opencode-worktree-enhanced/index.ts",
    "./plugins/opencode-metasearch2/index.ts"
  ],
  "mcp": {
    "paper-search": {
      "type": "local",
      "command": ["/home/rongzhou/.npm-global/bin/paper-search-mcp-nodejs"],
      "environment": {
        // "WOS_API_KEY": "your_actual_api_key_here",
        // "PUBMED_API_KEY": "your_ncbi_api_key_here",
        // "ELSEVIER_API_KEY": "your_elsevier_api_key",
        // "SPRINGER_API_KEY": "your_springer_api_key",
        // "WILEY_TDM_TOKEN": "your_wiley_tdm_token"
      },
      "enabled": true
    },
    "mcp_hugging_face": {
      "type": "remote",
      "enabled": false,
      "url": "https://huggingface.co/mcp?login",
      "oauth": {}
    },
    "brave-search": {
      "type": "local",
      "command": ["brave-search-mcp-server"],
      "environment": {
        "BRAVE_API_KEY_FILE": "/home/rongzhou/.config/opencode/.secrets/brave-api-key"
      },
      "enabled": true
    },
    "serena": {
      "type": "local",
      "enabled": true,
      "command": ["serena", "start-mcp-server", "--project-from-cwd"],
      "timeout": 10000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-f5804b2a-6ac7-4014-a70d-ff5cc8026427"
      },
      "enabled": true,
      "timeout": 10000
    },
    "mcp_github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": false,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.config/opencode/.secrets/github-pat}"
      }
    }
  },
  "provider": {
    "rr": {
      "models": {},
      "options": {
        "baseURL": "http://localhost:8000/v1"
      }
    }
  },

  "permission": {
    "bash": {
      // Destructive commands — agent must ask for approval:
      "git reset --hard*": "ask",         // destroys all uncommitted local work
      "git push --force*": "ask",          // overwrites remote history
      "git push -f*": "ask",               // same, short form
      "git clean -f*": "ask",              // deletes untracked files/folders
      "git checkout -- *": "ask",          // discards working tree changes
      "git restore .": "ask",              // same, modern form
      "git rm -r*": "ask",                 // removes files from both disk and git
      "git rebase *": "ask",               // rewrites commit history
      "git filter-branch*": "ask",         // repo-wide history rewrite (nuclear)
      "git branch -D*": "ask",             // force-deletes branches
      "git stash drop*": "ask",            // permanently deletes a stash
      "git stash clear*": "ask",           // deletes all stashes
      "docker system prune -af*": "ask",   // nukes all containers, images, networks
      "docker system prune --all*": "ask", // same, long flag form
      "docker rm -f *": "ask",             // force-removes containers
      "docker rmi -f *": "ask",            // force-removes images
      "docker volume rm -f *": "ask",      // destroys all volumes with data
      "find . -delete*": "ask",            // bulk deletion via find
      "find . -exec rm*": "ask",           // same, alternative syntax
      "sudo *": "ask",                     // any sudo command (escalation)
      "chmod -R 0*": "ask",                // locks all files in a directory
      "chown -R*": "ask",                  // bulk ownership change
      "truncate -s 0*": "ask",             // truncates files to zero bytes
      "dd if=/dev/zero of=*": "ask",       // zeroes out files or disks
      "rm -rf*": "ask",                    // classic filesystem nuke
      "rm -fr*": "ask",                    // same, flag order swapped
      "pkill*": "ask",                     // kills processes by name/pattern — inherently imprecise
      "killall*": "ask",                   // same, different tool
      "kill -9*": "ask"                    // SIGKILL by PID — can't be caught, data-loss risk
    },
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "~/.local/share/opencode/tool-output/**": "allow",
      "~/kodo/**": "allow",
      "~/.config/lighterbird/**": "allow",
      "~/.local/share/lighterbird/**": "allow",
      "~/tmp": "allow",
      "~/tmp/**": "allow"
    }
  },

  "agent": {
    "copilot": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "auditor": {
      "model": "deepseek/deepseek-v4-flash"
    },
    // "explore": {
    //   "model": "opencode/deepseek-v4-flash-free"
    // },
    // "tester": {
    //   "model": "opencode/deepseek-v4-flash-free"
    // },
  //   "debugger": {
  //     "model": "opencode/deepseek-v4-flash-free"
  //   },
  //   "reviewer": {
  //     "model": "opencode/deepseek-v4-flash-free"
  //   },
  //   "refactorer": {
  //     "model": "opencode/deepseek-v4-flash-free"
  //   },
    "architect": {
      "model": "deepseek/deepseek-v4-flash"
    },
  //   "planner": {
  //     "model": "opencode/deepseek-v4-flash-free"
  //   },
    "expert": {
      "model": "deepseek/deepseek-v4-flash"
    },
    "githubber": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "huggingfacer": {
      "model": "opencode/deepseek-v4-flash-free"
    },
    "gitmaster": {
      "model": "opencode/deepseek-v4-flash-free"
    }
  }
}
